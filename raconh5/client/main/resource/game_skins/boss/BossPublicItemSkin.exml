<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="BossPublicItemSkin" width="698" height="199" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<ns1:BitmapRemote id="_back" width="698" height="199" x="0" y="0"/>
	<e:Image source="common_head_back1_png" x="25" y="19"/>
	<ns1:BitmapRemote id="_head" width="101" height="125" x="34" y="5"/>
	<e:Image source="common_back2_png" x="7" y="134" width="176" scale9Grid="34,5,73,32" height="48"/>
	<e:Image source="boss_label_back_png" x="181" y="13"/>
	<e:Image id="_pkIcon" source="boss_pkIcon_png" x="0" y="0"/>
	<ns1:Label id="_txtName" text="Monster Name" x="6" y="147" textColor="0xFFFFFF" fontFamily="Microsoft YaHei" size="22" textAlign="center" anchorOffsetX="0" width="112"/>
	<ns1:Label id="_txtLv" text="Lv80" x="100" y="147" textColor="0xFFFFFF" fontFamily="Microsoft YaHei" size="22"/>
	<ns1:Label id="_txt0" text="HP:" x="187" y="22" fontFamily="Microsoft YaHei" size="22" textColor="0xffffff"/>
	<ns1:Label id="_txtCond" text="Unlocks at Lv.200" fontFamily="Microsoft YaHei" size="22" textColor="0xFF2400" horizontalCenter="252.5" verticalCenter="7.5" stroke="1.5"/>



	<ns1:ProgressBar id="_bar" width="250" height="20" x="259" y="23">
		<e:Skin>
			<e:Image width="100%" height="100%" source="strip_back_png"/>
			<e:Image id="thumb" width="100%" height="100%" source="strip_blue2_png"/>
			<ns1:Label id="labelDisplay" fontFamily="Microsoft YaHei" size="20" textColor="0xFFF7E6" horizontalCenter="0" verticalCenter="0"/>
		</e:Skin>
	</ns1:ProgressBar>
	<e:Group x="505" y="82">
		<ns1:Button id="_btn" label="" x="0" y="1" width="192" height="86">
		<ns1:skinName>
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_btn1_1_png" source.down="common_btn1_2_png"/>
			<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
			</e:Skin>
		</ns1:skinName>
		</ns1:Button>
		<e:Image id="_label" source="common_label_killed_png" touchEnabled="false" horizontalCenter="0" verticalCenter="0"/>
	</e:Group>

	<ns1:CheckBox id="_checkBox" label="关注" x="547" y="43">
		<e:Skin states="up,down,disabled,upAndSelected,downAndSelected,disabledAndSelected"> 
			<e:Image source="common_cb_rect_png" x="0" y="0"/>
			<e:Image source.upAndSelected="common_cb_selected_png" source.downAndSelected="" source.disabledAndSelected="" source="" x="0" y="0"/>
			<e:Label id="labelDisplay" size="24" textColor="0xFFFFFF" fontFamily="Microsoft YaHei" text="" x="48"  verticalCenter="0"/>
		</e:Skin>
	</ns1:CheckBox>


</e:Skin>