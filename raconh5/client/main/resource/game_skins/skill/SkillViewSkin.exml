	</ns1:Button>
	<e:Image id="_upgradeIcon" source="common_red_icon_png" x="620.5" y="1022.5" touchEnabled="false"/>
	<ns1:Button id="_allUpBtn" label="" x="61" y="1022" width="238" height="105">
