<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="ChatChannelBtnSkin" width="129" height="70" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<ns1:ToggleButton id="btn" label="" x="0" y="0">
        <ns1:skinName>
		<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_btn3_1_png" source.down="common_btn4_1_png"/>
			<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
		</e:Skin>
		</ns1:skinName>
    </ns1:ToggleButton>
    <e:Image source="{data.channelName}" horizontalCenter="0" verticalCenter="0" touchEnabled="false"/>
</e:Skin>