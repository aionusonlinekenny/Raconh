<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="BackgroundNoticeSkin" width="720" height="1280" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<e:Image source="notice_border_png" x="105" y="330"/>
	<ns1:Label id="_txt" text="Attention! Server maintenance begins at 10:00 today, estimated 30 minutes. We apologize for the inconvenience. — Game Operations Team" x="166" y="369" width="420" height="145" fontFamily="Microsoft YaHei" textColor="0x7c6e62" size="22" textAlign="left" lineSpacing="17" multiline="true" verticalAlign="middle"/>
	<ns1:Button id="_closeBtn" label="" x="584" y="355">
		<ns1:skinName>
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_tip_close_png"/>
			<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
			</e:Skin>
		</ns1:skinName>
	</ns1:Button>
</e:Skin>