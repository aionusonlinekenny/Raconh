<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="MarketBuyTipsViewSkin" width="720" height="1280" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<ns1:BasePopUpView id="_popupView" width="100%" height="100%" x="0" y="0" skinName="BasePopUpSkin" scaleX="1" scaleY="1" locked="true"/>
	<ns1:BaseGoods id="_goods" width="141" height="141" x="290" y="324" skinName="BaseGoodsSkin"/>


	<ns1:Button id="_buyBtn" label="Button" y="804" x="241" scaleX="1" scaleY="1">
		<ns1:skinName>
		<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_btn2_1_png" source.down="common_btn2_2_png"/>
			<e:Image width="181" height="52" source="shop_goumai_png" horizontalCenter="0" verticalCenter="0"/>
		</e:Skin>
		</ns1:skinName>
	</ns1:Button>
	<ns1:Button id="_jianBtn" label="Button" x="175" y="615" width="70" scaleX="1" scaleY="1">
		<ns1:skinName>
		<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common__jian_png"/>
		</e:Skin>
		</ns1:skinName>
	</ns1:Button>
	<ns1:Button id="_jiaBtn" label="Button" x="476" y="614" width="70" scaleX="1" scaleY="1">
		<ns1:skinName>
		<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_jia_png"/>
		</e:Skin>
		</ns1:skinName>
	</ns1:Button>
	<ns1:TextInput id="_inputNumTxt" width="212" height="60" y="622" anchorOffsetX="0" anchorOffsetY="0" skinName="BaseTextInputSkin" x="254"/>










	<e:Image source="marketsheet.market_di_png" y="717" horizontalCenter="0"/>
	<e:Image source="commonsheet.panel_gold_54_png" y="722" x="303"/>
	<e:Image source="marketsheet.market_di_png" y="520" horizontalCenter="0"/>
	<e:Image source="commonsheet.panel_gold_54_png" y="522" x="303"/>
	<ns1:Label id="_goldTxt" text="数量" y="733" size="30" fontFamily="Microsoft YaHei" textColor="0x7C6E62" scaleX="1" scaleY="1" anchorOffsetX="0" width="169" textAlign="left" x="353"/>


	<ns1:Label id="_priceTxt" text="数量" y="534" size="30" fontFamily="Microsoft YaHei" textColor="0x7C6E62" scaleX="1" scaleY="1" anchorOffsetX="0" width="187" textAlign="left" x="353"/>
	<ns1:Label text="单价" x="93" y="536" size="30" fontFamily="Microsoft YaHei" textColor="0x7C6E62"/>
	<ns1:Label text="总价" x="93" y="733" size="30" fontFamily="Microsoft YaHei" textColor="0x7C6E62"/>

	<ns1:Label text="数量" x="93" y="633" size="30" fontFamily="Microsoft YaHei" textColor="0x7c6e62"/>
	<ns1:Label id="_nameTxt" text="Label" y="463" rotation="0" anchorOffsetX="0" width="203" anchorOffsetY="0" height="38" textAlign="center" scaleX="1" scaleY="1" x="259" fontFamily="Microsoft YaHei"/>


</e:Skin>