	<e:Image width="300" height="3" y="78" source="common_line_png" scale9Grid="320,0,25,3" horizontalCenter="0.5"/>
	<ns1:Label text="Set Effect" x="8" y="89" textColor="0xffa800" size="24" fontFamily="Microsoft YaHei"/>
	<ns1:Label id="_attrValue" text="{data.suitAttr}" x="8" y="122" size="24" fontFamily="Microsoft YaHei" textColor="0x7c6e62" width="330"/>
</e:Skin>