<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="SuitAllAttrItemSkin" width="350" height="{data.viewHeight}" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*">
	<w:Config id="160caa55309" ></w:Config>
