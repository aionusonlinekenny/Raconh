<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="PetFeedItemSkin" width="700" height="156" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<e:Image source="common_wordBg_normal_png" left="0" right="0" top="0" bottom="0"/>
	<ns1:Goods id="_goods" width="141" height="141" x="34" y="0" skinName="BaseGoodsSkin"/>
	<ns1:Label id="_nameTxt" text="宠物资质丹" x="49" y="123" size="22" fontFamily="Microsoft YaHei" textColor="0x7c6e62" width="111" textAlign="center" verticalAlign="middle"/>
	<ns1:Label id="_hasUseTxt" text="当前已使用：6" x="210" y="46" size="28" fontFamily="Microsoft YaHei" textColor="0x7e6c62" width="250"/>
	<ns1:Label id="_canUseTxt" text="当前可使用：30" x="210" y="88" textColor="0x7e6c62" size="28" fontFamily="Microsoft YaHei" width="250"/>
	<ns1:Label id="_leftTxt" text="剩余：2个" x="477" y="20" size="22" fontFamily="Microsoft YaHei" textColor="0x7e6c62" width="197" textAlign="center" verticalAlign="middle"/>
	<ns1:Button id="_useBtn" label="" x="477" y="39" width="197" height="90">
		<ns1:skinName>
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_btn1_1_png" source.down="common_btn1_2_png"/>
            <e:Image source="common_label_use_png" x="8" y="19"/>
			<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
			</e:Skin>
		</ns1:skinName>
	</ns1:Button>
	<e:Image id="_redIcon" source="common_red_icon_png" x="638" y="36" visible="false"/>
</e:Skin>