	<e:Image id="_hongImg" source="shop_hong_png" y="182" height="2" x="36" fillMode="clip"/>
	<e:Image id="_vipImg" source="shop_vip_png" y="258" horizontalCenter="0"/>
	<ns1:Label id="_agioTxt" text="-1" x="-4.83" y="47.35" rotation="314.1" textAlign="center" anchorOffsetX="0" width="73.62" fontFamily="Microsoft YaHei" size="25"/>
