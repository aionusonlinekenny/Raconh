	<e:Image id="_redIcon" source="common_red_icon_png" x="298" y="180" visible="false"/>
	<ns1:JuexueJuanzouAttrTweenItem id="_attrItem" width="640" height="528" x="40" y="487" anchorOffsetX="0" anchorOffsetY="0"/>
