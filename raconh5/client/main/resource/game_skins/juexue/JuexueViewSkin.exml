<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="JuexueViewSkin" width="720" height="1280" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<ns1:BitmapRemote id="_bitimg" width="710" height="595" x="5" y="429"/>
