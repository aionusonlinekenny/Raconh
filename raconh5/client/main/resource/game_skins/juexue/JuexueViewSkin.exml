		<e:Image source="common_fighting_png" y="0" x="0"/>
		<e:Image source="common_zhanli2_png" x="16" y="3"/>
	</e:Group>
	<ns1:JuexueJuanzouTweenItem id="_juanzouItem" width="640" height="528" x="36" y="495" anchorOffsetX="0" anchorOffsetY="0" skinName="JuexueJuanzouTweenItemSkin"/>

	<e:Group id="_btnGroup" x="70" y="1032" visible="false">
		<ns1:Button id="_xinfuBtn" label="Button" x="0" y="0">
			<ns1:skinName>
			<e:Skin states="up,down,disabled">
				<e:Image width="100%" height="100%" source="common_btn2_1_png" source.down="common_btn2_2_png"/>
				<e:Image width="181" height="52" source="juexue_huoquxinfa_png" horizontalCenter="0" verticalCenter="0"/>
