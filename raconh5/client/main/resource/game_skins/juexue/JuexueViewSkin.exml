	<e:Image source="juexue_juexueqizi_png" x="391" y="144"/>
	<e:Image source="juexue_jingjie_png" x="451" y="171"/>
	<e:Image source="juexue_di_png" x="50" y="256"/>
	<ns1:BaseHScrollerList id="_hScroller" width="578" height="64" y="428" anchorOffsetX="0" anchorOffsetY="0" x="71"/>
	<ns1:Label id="_shuexiTxt0" text="Label" x="466" y="234" anchorOffsetX="0" width="182" fontFamily="Microsoft YaHei"/>
	<ns1:Label id="_shuexiTxt1" text="Label" x="466" y="270" anchorOffsetX="0" width="181" fontFamily="Microsoft YaHei"/>
	<ns1:Label id="_shuexiTxt2" text="Label" x="466" y="305" anchorOffsetX="0" width="182" fontFamily="Microsoft YaHei"/>
