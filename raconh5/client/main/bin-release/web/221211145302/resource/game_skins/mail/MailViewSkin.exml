<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="MailViewSkin" width="720" height="1280" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*">
	<ns1:BaseVScrollerList id="_mailList" width="661" height="850" x="32" y="120"/>
	<!-- Replaced mail_tips_png image (Chinese hardcoded) with a text label -->
	<ns1:Label text="Unclaimed mail is saved for 15 days" x="20" y="1002" width="680" textAlign="center" fontFamily="Microsoft YaHei" textColor="0x7C6E62" size="24"/>
	<e:Button id="_allBtn" label="Claim All" x="238" y="1025" width="244" height="100">
		<e:skinName>
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_btn1_1_png" source.down="common_btn1_2_png"/>
			<!-- Removed one_key_fetch_png (Chinese image), use label text instead -->
			<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0" textColor="0xFFFFFF" size="28" fontFamily="Microsoft YaHei" bold="true"/>
			</e:Skin>
		</e:skinName>
	</e:Button>
</e:Skin>
