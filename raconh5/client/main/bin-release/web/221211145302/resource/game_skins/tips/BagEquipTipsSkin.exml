	<e:Group id="_group" verticalCenter="0" horizontalCenter="0">
		<e:Image id="_bgImg" x="408" y="0" anchorOffsetX="0" width="200" anchorOffsetY="0" height="135" source="common_tipsBg_png" scale9Grid="48,48,19,19"/>
