		<ns1:Label id="_rank" text="999" x="144" y="144" size="22" fontFamily="Microsoft YaHei" scaleX="1" scaleY="1" textColor="0x4eff00"/>
		<e:Image width="720" height="45" x="0" y="938" source="common_back5_png" scale9Grid="103,21,13,0" anchorOffsetX="0"/>
		<e:Group id="_timeGroup" width="230" height="40" x="32" y="942">
			<e:Label text="Attempts:" x="0" y="7" size="22" fontFamily="Microsoft YaHei" scaleX="1" scaleY="1"/>
			<ns1:Label id="_playTimes" text="10/10" x="115" y="8" size="22" fontFamily="Microsoft YaHei" scaleX="1" scaleY="1" textColor="0x4eff00"/>
