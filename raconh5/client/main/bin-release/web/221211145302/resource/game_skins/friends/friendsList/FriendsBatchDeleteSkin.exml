<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="FriendsBatchDeleteSkin" width="720" height="1280" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<ns1:BasePopUpView id="_basePopUp" width="100%" height="100%"/>
	<e:Image id="_titleImg" y="317" x="284" source="friends_batch_delete_png"/>
	<ns1:BaseVScrollerList id="_list" width="671" height="286" x="23" y="377"/>
	<ns1:Button id="_delBtn" label="" x="240" y="673">
		<ns1:skinName>
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_btn1_1_png" source.down="common_btn1_2_png"/>
            <e:Image source="friends_btn_delete_png" horizontalCenter="0" verticalCenter="0"/>
			<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
			</e:Skin>
		</ns1:skinName>
	</ns1:Button>
	<ns1:Label text="全选" x="561" y="707" size="24" fontFamily="Microsoft YaHei"/>
	<ns1:CheckBox id="_allCB" label="" x="625" y="699">
		<ns1:skinName>
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="friends_checkbox_normal_png" source.down="friends_checkbox_selected_png"/>
			<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
			</e:Skin>
		</ns1:skinName>
	</ns1:CheckBox>
</e:Skin>