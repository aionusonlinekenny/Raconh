	<e:Image source="playRes_gold_54_png" x="161" y="74"/>
	<ns1:Label id="_txt" text="Spend 100 to clear cooldown?" y="87" size="28" textColor="0x7C6E62" fontFamily="Microsoft YaHei" scaleX="1" scaleY="1" x="48" anchorOffsetX="0" textAlign="left" anchorOffsetY="0"/>
	<ns1:CheckBox id="_checkBox" label="不再提示" x="149" y="144">
		<e:Skin states="up,down,disabled,upAndSelected,downAndSelected,disabledAndSelected">
		<e:Image source="common_cb_rect_png" x="0" y="0"/>
		<e:Image source.upAndSelected="common_cb_selected_png" source.downAndSelected="" source.disabledAndSelected="" source="" x="0" y="0"/>
		<e:Label id="labelDisplay" size="24" textColor="0x7C6E62" fontFamily="Microsoft YaHei" text="" x="48" verticalCenter="0"/>
		</e:Skin>
	</ns1:CheckBox>
	<ns1:Button id="_btnConfirm" label="" y="203" width="197" height="90" x="237" scaleX="1" scaleY="1">
		<ns1:skinName>
		<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_btn1_1_png" source.down="common_btn1_2_png"/>
			<e:Image source="confirm_png" horizontalCenter="0" verticalCenter="0"/>
		</e:Skin>
		</ns1:skinName>
	</ns1:Button>
	<ns1:Button id="_btnCancel" label="" y="204" width="197" height="90" x="15" scaleX="1" scaleY="1">
		<ns1:skinName>
		<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_btn2_1_png" source.down="common_btn2_2_png"/>
			<e:Image source="common_label_quxiao_png" horizontalCenter="0" verticalCenter="0"/>
		</e:Skin>
		</ns1:skinName>
	</ns1:Button>
	<e:Image id="_btnClose" source="common_tip_close_png" x="421" y="0"/>
