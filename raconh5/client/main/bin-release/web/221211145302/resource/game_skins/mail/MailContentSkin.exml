<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="MailContentSkin" width="720" height="1280" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*">
	<w:Config id="15f5cbba85c"/>
	<ns1:BasePopUpView id="_popupView" width="100%" height="100%"/>

	<e:Image source="mail_content_title_png" x="282" y="314"/>

	<e:Image y="381" source="common_title_wordBg_png" horizontalCenter="0.5"/>
	<ns1:Label id="_titleTxt" text="Starter Pack" y="383" fontFamily="Microsoft YaHei" textColor="0x7c6e62" width="710" size="28" anchorOffsetX="0" x="5" textAlign="center"/>
	<ns1:Label id="_contentTxt" text="Dear Player" x="20" y="429" fontFamily="Microsoft YaHei" textColor="0x7c6e62" size="24" textAlign="left" wordWrap="true" anchorOffsetX="0" width="674"/>
	<e:Image source="split_line_png" x="31" y="522"/>
	<ns1:Label text="Attachment:" x="20" y="527" textColor="0x7c6e62" size="24" fontFamily="Microsoft YaHei"/>

	<ns1:Button id="_fetchBtn" label="" x="262" y="680" width="197" height="90">
		<ns1:skinName>
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_btn1_1_png" source.down="common_btn1_2_png"/>
            <e:Image source="fetch_png" x="8" y="19"/>
			<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
			</e:Skin>
		</ns1:skinName>
	</ns1:Button>



</e:Skin>