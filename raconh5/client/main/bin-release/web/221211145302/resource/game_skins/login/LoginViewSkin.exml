<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="LoginViewSkin" width="880" height="1280" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<ns1:BitmapRemote id="_back" width="880" height="1280" x="0" y="0"/>
	<e:Image id="_serverBack" source="login_labelBack_png" x="145" y="898" width="596" height="56" scale9Grid="81,7,66,42"/>
	<e:Image id="_icon" source="login_iconHot_png" x="200" y="898" width="42" height="54" touchEnabled="false"/>
	<e:Image id="_btnEnter" source="login_btnStart_png" x="296" y="1027" width="292" height="93"/>

	<ns1:Label id="_txtServer" text="Test Server" x="242" y="911" fontFamily="Microsoft YaHei" anchorOffsetX="0" width="272" textAlign="center" touchEnabled="false"/>
	<ns1:Label id="_txtClick" text="Switch Server" x="510" y="911" fontFamily="Microsoft YaHei" anchorOffsetX="0" width="210" textAlign="left" touchEnabled="false"/>

	<e:Group id="_groupDebug" x="200" y="795">
		<!-- Account row -->
		<e:Image scale9Grid="6,6,38,38" x="118" y="0" anchorOffsetX="0" width="231" anchorOffsetY="0" height="34" source="login_rect_1_png"/>
		<ns1:Label text="Account:" x="0" y="0" fontFamily="Microsoft YaHei" anchorOffsetX="0" width="122" textAlign="left"/>
		<ns1:Label id="_inputClient" text="" x="123" y="1" fontFamily="Microsoft YaHei" anchorOffsetX="0" textAlign="left" touchEnabled="false" type="input" width="225"/>
		<!-- Password row: wrapped in named Group so translate.js can hide it when session is active -->
		<e:Group id="_groupPwd" x="0" y="44">
			<e:Image scale9Grid="6,6,38,38" x="118" y="0" anchorOffsetX="0" width="231" anchorOffsetY="0" height="34" source="login_rect_1_png"/>
			<ns1:Label text="Password:" x="0" y="0" fontFamily="Microsoft YaHei" anchorOffsetX="0" width="122" textAlign="left"/>
			<ns1:Label id="_inputPassword" text="" x="123" y="1" fontFamily="Microsoft YaHei" anchorOffsetX="0" textAlign="left" touchEnabled="true" type="input" width="225"/>
		</e:Group>
		<!-- Error message -->
		<ns1:Label id="_lblError" text="" x="0" y="88" fontFamily="Microsoft YaHei" anchorOffsetX="0" width="360" textAlign="center" size="18" textColor="0xFF4444"/>
	</e:Group>

</e:Skin>
