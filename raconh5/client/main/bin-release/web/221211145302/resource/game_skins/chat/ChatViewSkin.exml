<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="ChatViewSkin" width="720" height="1280" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<e:Image source="chat_back_png" scale9Grid="15,37,11,225" x="0" y="737" width="100%" height="402"/>
	<e:Image source="chat_btn_back_png" x="0" y="737"/>

	<ns1:BaseVScrollerList id="_channelList" width="132" height="296" x="0" y="739"/>
	<ns1:Button id="_backBtn" label="" x="7" y="1052">
		<ns1:skinName>
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="friends_backBtn_png"/>
			<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
			</e:Skin>
		</ns1:skinName>
	</ns1:Button>
	<ns1:Button id="_faceBtn" label="" x="468" y="1053">
		<ns1:skinName>
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="friends_face_png"/>
			<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
			</e:Skin>
		</ns1:skinName>
	</ns1:Button>
	<ns1:Button id="_sendBtn" label="" x="528" y="1043" width="192" height="90">
		<ns1:skinName>
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="common_btn1_1_png" source.down="common_btn1_2_png"/>
            <e:Image source="friends_sendBtn_png" horizontalCenter="0" verticalCenter="0"/>
			<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0"/>
			</e:Skin>
		</ns1:skinName>
	</ns1:Button>
	<ns1:TextInput id="_input" width="327" height="62" x="136" y="1058" skinName="BaseTextInputSkin" prompt="聊天发送信息输入区域" maxChars="30"/>
	<ns1:Scroller id="_msgScroll" width="581" height="286" x="136" y="745">
		<e:Group id="_msgGroup"/>
	</ns1:Scroller>
</e:Skin>