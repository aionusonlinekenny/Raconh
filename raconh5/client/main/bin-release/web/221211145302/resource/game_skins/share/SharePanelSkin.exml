<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="SharePanelSkin" width="720" height="1280" xmlns:e="http://ns.egret.com/eui" xmlns:ns1="*" xmlns:w="http://ns.egret.com/wing">
	<ns1:BasePopUpView id="_popupView" width="720" height="1280" x="0" y="0" skinName="BasePopUpSkin"/>
	<ns1:Button id="_shareBtn" label="Button" y="790" x="241">
